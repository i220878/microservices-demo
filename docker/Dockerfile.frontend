# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM golang:1.25-alpine AS builder

# Install git (needed for go modules that fetch remote deps)
RUN apk add --no-cache git

WORKDIR /app

# Copy go module files first to cache dependency downloads
COPY src/frontend/go.mod src/frontend/go.sum ./

RUN go mod download

# Copy the rest of the frontend source
COPY src/frontend/ .

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -o frontend .

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM alpine:3.18

WORKDIR /app

# Copy the compiled binary from the builder stage
COPY --from=builder /app/frontend .

# Copy static assets and templates needed at runtime
COPY src/frontend/templates/ ./templates/
COPY src/frontend/static/    ./static/

# The frontend listens on port 8080
EXPOSE 8080

# Run the binary
ENTRYPOINT ["/app/frontend"]
