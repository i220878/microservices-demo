# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

WORKDIR /app

COPY src/productcatalogservice/go.mod src/productcatalogservice/go.sum ./

RUN go mod download

COPY src/productcatalogservice/ .

RUN CGO_ENABLED=0 GOOS=linux go build -o productcatalogservice .

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM alpine:3.18

WORKDIR /app

COPY --from=builder /app/productcatalogservice .

# The products JSON must be present at runtime
COPY src/productcatalogservice/products.json .

# gRPC port
EXPOSE 3550

ENTRYPOINT ["/app/productcatalogservice"]
